# Copy to .env — EXPO_PUBLIC_* values ship inside the app bundle, so keep secrets out.
#
# Leave the URLs blank for an emulator: config/env.ts defaults to 10.0.2.2 on Android
# (an emulator resolves localhost to itself). Set them only for a physical device.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WS_URL=

# 1 runs the app against src/services/api/demo/ with no server. 0 (or absent) uses the
# real API. Ship builds must have this off.
EXPO_PUBLIC_DEMO_MODE=0

# Unused: components/map/ is a hand-authored SVG city, not Mapbox.
EXPO_PUBLIC_MAPBOX_TOKEN=
