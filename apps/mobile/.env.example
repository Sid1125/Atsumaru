# Copy to .env — EXPO_PUBLIC_* values ship inside the app bundle, so keep secrets out.
#
# Leave the URLs blank for an emulator: config/env.ts defaults to 10.0.2.2 on Android
# (an emulator resolves localhost to itself). Set them only for a physical device.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WS_URL=

# 1 runs the app against src/services/api/demo/ with no server. 0 (or absent) uses the
# real API. Ship builds must have this off.
EXPO_PUBLIC_DEMO_MODE=0

# Public Mapbox token (pk.*). Set it and Discover renders real Mapbox tiles; leave it blank
# and it renders the hand-authored vector city in components/map/. Both are complete maps —
# this picks the ground, not whether there is one.
#
# A token alone is not enough: @rnmapbox/maps is native, so Expo Go cannot load it and a
# dev build (`npx expo run:android`) is required. See components/map/mapbox.ts.
#
# It also powers the venue place-search on create-event (Search Box API), which needs no
# native module and so works in Expo Go. Blank there means hosting falls back to a fixed
# central point, and the screen says so.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Cloudflare Turnstile site key for the auth gate (docs/SECURITY_AUDIT.md §22).
# Leave blank when the server has no TURNSTILE_SECRET_KEY set (no challenge). When both are
# set, the app must present a widget token on /auth/session or the handoff is rejected.
# Needs react-native-webview + a dev build to actually mint a token (see services/auth/turnstile.ts).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# Push notifications (docs/TRD.md §14, TRACKER.md §1g).
# Expo push requires an EAS project id in app.json (extra.eas.projectId), set via `eas init`.
# Android also needs FCM credentials configured in the Expo dashboard + a dev build
# (expo run:android) — Expo Go cannot receive remote push on Android since SDK 53.
# On iOS, the same EAS project id + Apple push key in the Expo dashboard.
