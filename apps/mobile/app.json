{
  "expo": {
    "name": "Atsumaru",
    "slug": "atsumaru",
    "scheme": "atsumaru",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5E5CC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atsumaru.app"
    },
    "android": {
      "package": "com.atsumaru.app",
      "backgroundColor": "#F5E5CC",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F5E5CC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "POST_NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": null
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Atsumaru uses your photo only as your profile picture."
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.23.1"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Atsumaru uses your location only to show nearby meetups."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#CE4503"
        }
      ]
    ]
  }
}
