{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "developmentClient": {
        "enabled": true
      },
      "android": {
        "gradleCommand": ":_app:assembleDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "android": {
        "gradleCommand": ":_app:assembleRelease"
      },
      "ios": {
        "workflow": "managed",
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountPath": "google-play-service-account.json"
      },
      "ios": {
        "appleId": "APPLE_ID",
        "ascProviderId": "PROVIDER_ID"
      }
    }
  }
}
