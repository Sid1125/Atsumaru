{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "developmentClient": {
        "enabled": true
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "0"
      }
    },
    "production": {
      "ios": {
        "workflow": "managed",
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "0"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountPath": ""
      },
      "ios": {}
    }
  }
}
