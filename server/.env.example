# Copy to server/.env — never commit the real file.
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# Supabase (service-role key is server-only and bypasses RLS)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq (onboarding AI). llama-3.3-70b-versatile is decommissioned and 404s — do not
# reinstate it. gpt-oss-120b has the same 131k context and JSON-mode support.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# HuggingFace (MiniLM embeddings)
HUGGINGFACE_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OAuth. Google is brokered by Supabase Auth: enable Auth → Providers → Google and put
# the Cloud-console client id + secret there, not here (GOOGLE_* below are unused by this
# server and kept only for reference). The Cloud console's authorized redirect URI is
# Supabase's own https://<ref>.supabase.co/auth/v1/callback.
# LINE has no Supabase provider, so this server exchanges its code and needs the channel
# credentials from the LINE Developers console.
#
# OAUTH_CALLBACK_URL is *our* callback. Supabase redirects the browser back to it after
# Google, so it must also appear in Supabase → Auth → URL Configuration → Redirect URLs
# (use http://10.0.2.2:4000/** for an Android emulator, the LAN IP for a real device, and
# the deployed origin in production). LINE's console must list it too.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/callback
APP_AUTH_REDIRECT=atsumaru://auth
# Signs the OAuth state blob — set a long random value per deployment. It also keys the
# in-memory PKCE verifier, so a forged state cannot redeem a code.
AUTH_STATE_SECRET=

# Optional: run the post-meetup sweep through BullMQ instead of the in-process timer.
# Upstash gives a rediss:// URL on the free tier.
REDIS_URL=
